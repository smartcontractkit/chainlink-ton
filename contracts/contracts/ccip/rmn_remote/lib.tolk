import "../../lib/access/access_control"
import "../../lib/utils"

const RMNREMOTE_GLOBAL_CURSE_SUBJECT =  0x01000000000000000000000000000001
const CURSE_ROLE = 0xb3c5b7cb9096e539f419cdc795a52c8cbe8dfbc9e27f70077d0b9749efe27fc5; // keccak256('CURSE_ROLE')
const UNCURSE_ROLE = 0x19331e9591f40b6bd5c2716faeab95f6a63184877fab2619bf484155c597abf0; // keccak256('UNCURSE_ROLE')

struct CursedSubjects {
    data: map<uint128, ()> = [];
}

fun CursedSubjects.curse(mutate self, subject: uint128) {
    self.data.addIfNotExists(subject, ());
}
fun CursedSubjects.uncurse(mutate self, subject: uint128) {
    self.data.delete(subject);
}
fun CursedSubjects.isCursed(self, subject: uint128) {
    // fastpath, majority of the time there's no curse
    if (self.data.isEmpty()) { return false; }
    val isGlobalCursed = self.data.exists(RMNREMOTE_GLOBAL_CURSE_SUBJECT);
    if (isGlobalCursed) {
        return true;
    }
    return self.data.exists(subject);
}

/// Shared, local curse policy. Contracts compose this storage rather than
/// relying on a Router-level policy being mirrored to every consumer.
struct CursePolicy {
    rbac: Cell<AccessControl_Data>;
    cursedSubjects: CursedSubjects;
}

struct (0xf3388046) CursePolicy_Curse {
    queryId: uint64;
    subjects: SnakedCell<uint128>;
}

struct (0x3f153a31) CursePolicy_Uncurse {
    queryId: uint64;
    subjects: SnakedCell<uint128>;
}

fun CursePolicy.hookTrait__AccessControl(self): AccessControl<null?> {
    return AccessControl<null?> { data: AccessControl_Data.fromCell(self.rbac), context: null, hooks: null };
}

fun CursePolicy.requireCurseRole(self, sender: address) {
    self.hookTrait__AccessControl().requireRole(CURSE_ROLE, sender);
}

fun CursePolicy.requireUncurseRole(self, sender: address) {
    self.hookTrait__AccessControl().requireRole(UNCURSE_ROLE, sender);
}

fun CursePolicy.init(admin: address, curser: address, uncurser: address): CursePolicy {
    // Initializing storage must not emit the reply messages generated by
    // AccessControl._grantRole, so construct the three role entries directly.
    var roles: map<uint256, Cell<AccessControl_RoleData>> = [];
    var defaultMembers: map<address, bool> = [];
    defaultMembers.set(admin, true);
    roles.set(DEFAULT_ADMIN_ROLE, AccessControl_RoleData {
        adminRole: DEFAULT_ADMIN_ROLE, membersLen: 1, hasRole: defaultMembers,
    }.toCell());
    var curseMembers: map<address, bool> = [];
    curseMembers.set(curser, true);
    roles.set(CURSE_ROLE, AccessControl_RoleData {
        adminRole: DEFAULT_ADMIN_ROLE, membersLen: 1, hasRole: curseMembers,
    }.toCell());
    var uncurseMembers: map<address, bool> = [];
    uncurseMembers.set(uncurser, true);
    roles.set(UNCURSE_ROLE, AccessControl_RoleData {
        adminRole: DEFAULT_ADMIN_ROLE, membersLen: 1, hasRole: uncurseMembers,
    }.toCell());
    return { rbac: AccessControl_Data { roles }.toCell(), cursedSubjects: CursedSubjects {} };
}
