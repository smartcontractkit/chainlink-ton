{
  "name": "@chainlink/contracts-ton",
  "private": true,
  "version": "1.6.2",
  "description": "Chainlink TON smart contracts",
  "author": "Chainlink Labs",
  "license": "see LICENSE in LICENSE",
  "files": [
    "build",
    "contracts",
    "wrappers"
  ],
  "scripts": {
    "bp": "blueprint",
    "start": "blueprint run",
    "clean": "[ -d build ] && rm -rf build || true",
    "build-only": "acton build",
    "build": "yarn clean && acton build && yarn build:tact && yarn build:adapt-acton-artifacts && yarn build:pin-artifacts && yarn generate-pkg",
    "build:tact": "for c in examples.async-communication.request-reply-with-two-dependencies.Inventory examples.async-communication.request-reply-with-two-dependencies.ItemCount examples.async-communication.request-reply-with-two-dependencies.ItemPrice examples.async-communication.request-reply-with-two-dependencies.Storage examples.async-communication.request-reply.ItemPrice examples.async-communication.request-reply.PriceRegistry examples.async-communication.request-reply.Storage examples.async-communication.two-msg-chain.Memory examples.async-communication.two-msg-chain.Storage examples.async-communication.two-phase-commit.Counter examples.async-communication.two-phase-commit.DB; do blueprint build \"$c\" || exit 1; done",
    "build:adapt-acton-artifacts": "ts-node scripts/actonBuildAdapter.ts",
    "build:pin-artifacts": "ts-node scripts/pinArtifacts.ts",
    "generate-pkg": "ts-node scripts/generateContractsPkg.ts",
    "test": "jest --verbose",
    "test-coverage": "COVERAGE=true jest",
    "generate-coverage-reports": "ts-node tests/coverage/scriptMergeCoverageIntoHtmlReports.ts",
    "fmt:check": "yarn fmt-contracts:check && yarn fmt-typescript:check",
    "fmt": "yarn fmt-contracts && yarn fmt-typescript",
    "fmt-contracts:check": "tact-fmt --check contracts",
    "fmt-contracts": "tact-fmt --write contracts",
    "fmt-typescript:check": "prettier --check .",
    "fmt-typescript": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "ccip-gas-report": "blueprint test --gas-report -- --config ccip-gas-report.config.ts",
    "wgram-gas-report": "blueprint test --gas-report -- --config wgram-gas-report.config.ts",
    "get-key-pair": "ts-node scripts/getKeyPair.ts",
    "check-overflows": "ts-node scripts/overflowCheck.ts"
  },
  "dependencies": {
    "@ethersproject/keccak256": "^5.8.0",
    "ethers": "^6.15.0"
  },
  "devDependencies": {
    "@changesets/cli": "~2.29.6",
    "@tact-lang/compiler": "1.6.13",
    "@ton-community/func-js": "0.10.0",
    "@ton/blueprint": "0.44.2",
    "@ton/core": "0.63.1",
    "@ton/crypto": "3.3.0",
    "@ton/sandbox": "0.44.0",
    "@ton/test-utils": "0.12.0",
    "@ton/tolk-js": "1.4.1",
    "@ton/ton": "16.2.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.0",
    "crc-32": "^1.2.2",
    "jest": "^30.0.5",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.1",
    "ts-morph": "^24.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "zlib": "^1.0.5"
  },
  "resolutions": {
    "axios": "v1.16.1",
    "lodash": "^4.18.1",
    "protobufjs": "^7.5.5"
  },
  "pnpm": {
    "overrides": {
      "axios": "v1.16.1",
      "lodash": "^4.18.1",
      "protobufjs": "^7.5.5"
    }
  }
}
